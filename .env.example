# --- Database: Neon (Postgres) ----------------------------------------------
# Injected automatically by the Vercel ↔ Neon integration. Locally, copy your
# Neon connection string here. Either name works (POSTGRES_URL is also read).
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# --- Clip relay: Vercel Blob ------------------------------------------------
# Injected automatically when a Vercel Blob store is connected to the project.
# Only needed for the 2-device sync (/sync) clip fallback. Locally, set it from
# the Blob store's "Read/Write Token".
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx

# --- Optional TURN relay for strict-NAT sync sessions (/sync) ----------------
# Lets the direct WebRTC data channel traverse strict/symmetric NAT so clips
# stay on the fast streaming path. Entirely optional: without TURN the app still
# works — clips fall back to the Vercel Blob relay. Comma-separate multiple URLs.
# NEXT_PUBLIC_TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:5349
# NEXT_PUBLIC_TURN_USERNAME=
# NEXT_PUBLIC_TURN_CREDENTIAL=
