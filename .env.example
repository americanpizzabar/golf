# Supabase (publishable / anon key — safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key

# Optional TURN relay for 2-device synchronized recording (/sync).
# Lets the direct WebRTC data channel traverse strict/symmetric NAT (common on
# mobile carriers and corporate Wi-Fi) so recorded clips stay on the fast
# streaming path. Entirely optional: without TURN the app still works — clips
# fall back to a transient Supabase Storage relay that is deleted right after
# hand-off. Bring your own TURN provider (Twilio, Metered, self-hosted coturn).
# Comma-separate multiple URLs.
# NEXT_PUBLIC_TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:5349
# NEXT_PUBLIC_TURN_USERNAME=
# NEXT_PUBLIC_TURN_CREDENTIAL=
